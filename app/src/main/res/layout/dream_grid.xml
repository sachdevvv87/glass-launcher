<?xml version="1.0" encoding="utf-8"?>
<!-- Grid screensaver: today's Tron wallpapers, a slow drift, the time and the scene name. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dream_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/dream_photo_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/dream_photo_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Live Tron grid, used only if no wallpaper can be shown. -->
    <com.glass.launcher.GridBackgroundView
        android:id="@+id/dream_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dream_scrim" />

    <LinearLayout
        android:id="@+id/dream_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="72dp"
        android:layout_marginBottom="56dp"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/dream_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:format12Hour="h:mm"
            android:format24Hour="H:mm"
            android:shadowColor="#CC000000"
            android:shadowDy="2"
            android:shadowRadius="12"
            android:textColor="#F2FFFFFF"
            android:textSize="88sp" />

        <TextClock
            android:id="@+id/dream_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:shadowColor="#CC000000"
            android:shadowDy="1"
            android:shadowRadius="8"
            android:textColor="#CCFFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="40dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dream_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="460dp"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
