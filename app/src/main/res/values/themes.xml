<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Glass" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <!-- Same gradient as the layout, so there is no flash while starting. -->
        <item name="android:windowBackground">@drawable/bg_wallpaper</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorAccent">#FFFFFFFF</item>
    </style>

    <!-- Setup screen -->
    <style name="Glass" />

    <style name="Glass.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="Glass.Heading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Glass.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#CCFFFFFF</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Glass.Caption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:textColor">#8CFFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Glass.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:background">@drawable/glass_panel</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">26dp</item>
    </style>

    <style name="Glass.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/glass_button</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">26dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingEnd">26dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:textColor">@color/menu_item_text</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
