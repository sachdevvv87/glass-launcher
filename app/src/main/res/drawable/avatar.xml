<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#FF6E7380"
                android:startColor="#FFA7ACB8" />
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="5dp"
        android:drawable="@drawable/ic_person"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp" />
</layer-list>
