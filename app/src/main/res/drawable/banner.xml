<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 banner shown by the TV's own app list. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="320dp"
                android:height="180dp" />
            <gradient
                android:angle="315"
                android:endColor="#FF0B1020"
                android:startColor="#FF2F4A80" />
        </shape>
    </item>
    <item
        android:bottom="45dp"
        android:drawable="@drawable/ic_logo"
        android:left="115dp"
        android:right="115dp"
        android:top="45dp" />
</layer-list>
