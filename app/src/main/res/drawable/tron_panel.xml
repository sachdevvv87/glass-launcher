<?xml version="1.0" encoding="utf-8"?>
<!-- Grid theme menu: near-black panel, cyan edge, a faint outer glow line. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="5dp"
                android:color="#332BE6FF" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#F2000910" />
            <stroke
                android:width="1.5dp"
                android:color="#FF2BE6FF" />
        </shape>
    </item>
</layer-list>
